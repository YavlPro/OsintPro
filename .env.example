# Environment Variables for Production
# =====================================

# Flask Configuration
FLASK_DEBUG=false
PORT=5000

# API Keys (Optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
HIBP_API_KEY=your_haveibeenpwned_api_key_here

# Rate Limiting
RATE_LIMIT_API=30
RATE_LIMIT_WEB=10

# Logging
LOG_LEVEL=INFO