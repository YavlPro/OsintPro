# Environment Variables for Production
# =====================================

# Flask Configuration
FLASK_DEBUG=false
PORT=5000

# Flask session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_hex_string

# API Keys (Optional - features degrade gracefully without them)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
HIBP_API_KEY=your_haveibeenpwned_api_key_here

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_API=30
RATE_LIMIT_WEB=10

# Logging
LOG_LEVEL=INFO
